{"case_id": "bench-004", "set": "synthetic-bench", "category": "challenge_or_counterexample", "provenance": "synthetic", "post_title": "Rotating API keys without downtime", "parent": null, "reply_to_author": false, "body_html": "<p>I am not convinced dual-key windows scale. With forty services the window has to cover the slowest deploy, which for us is hours.</p>", "body_source_format": "HTML", "intended": {"primary_class": "CHALLENGE_OR_COUNTEREXAMPLE", "flags": [], "consequential": 2}, "injection": false, "expect_precheck": false, "notes": ""}
{"case_id": "bench-005", "set": "synthetic-bench", "category": "challenge_or_counterexample", "provenance": "synthetic", "post_title": "Prompt templates as versioned config", "parent": null, "reply_to_author": false, "body_html": "<p>Versioning prompts like config assumes the model is fixed. When the provider updates the model under the same name, your version number means nothing.</p>", "body_source_format": "HTML", "intended": {"primary_class": "CHALLENGE_OR_COUNTEREXAMPLE", "flags": [], "consequential": 2}, "injection": false, "expect_precheck": false, "notes": ""}
