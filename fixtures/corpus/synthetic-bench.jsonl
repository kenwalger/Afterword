{"case_id": "bench-001", "set": "synthetic-bench", "category": "correction", "provenance": "synthetic", "post_title": "What I learned migrating a monolith to Postgres 17", "parent": null, "reply_to_author": false, "body_html": "<p>The <code>pg_upgrade</code> flag in step 4 is <code>--link</code>, not <code>--hard-link</code>. The command as written exits with an unknown option.</p>", "body_source_format": "HTML", "intended": {"primary_class": "CORRECTION", "flags": [], "consequential": 3}, "injection": false, "expect_precheck": false, "notes": ""}
{"case_id": "bench-002", "set": "synthetic-bench", "category": "correction", "provenance": "synthetic", "post_title": "A rate limiter in forty lines of Go", "parent": null, "reply_to_author": false, "body_html": "<p>Small thing: the post says the bucket refills every second, but the code refills every 100 ms.</p>", "body_source_format": "HTML", "intended": {"primary_class": "CORRECTION", "flags": [], "consequential": 2}, "injection": false, "expect_precheck": false, "notes": ""}
